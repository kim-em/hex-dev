          carrier :=
            { carrier := Hex.DensePoly.ofCoeffs #[1, 0, 1], repeated := Hex.DensePoly.ofCoeffs #[1],
              derivPart := Hex.DensePoly.ofCoeffs #[0, 2], factorScale := 1, derivScale := 1,
