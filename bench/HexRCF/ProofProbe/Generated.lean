                { chain := #[Hex.DensePoly.ofCoeffs #[1, 0, 1], Hex.DensePoly.ofCoeffs #[0, 1], Hex.DensePoly.ofCoeffs #[-1]],
                  derivScale := 2,
                  steps := #[{ leftScale := 1, quotient := Hex.DensePoly.ofCoeffs #[0, 1], rightScale := 1 }] } },
          isolations := { intervals := #[] } }
