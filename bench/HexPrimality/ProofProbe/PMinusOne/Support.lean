/-- Execute each distinct input once, keeping checker results and route
accounting observable. This is search attribution, not kernel proof replay. -/
def run (family : String) (enabled : Bool) : IO Unit := do
  let input ← IO.mkRef (cases family, enabled)
  let (inputs, enabled) ← input.get
  if inputs.isEmpty then throw (IO.userError "unknown construction family")
  for (name, n, maxBits) in inputs do
    let result := construct n 0 enabled maxBits
    IO.println ((Json.mkObj [("case", toJson name), ("enabled", toJson enabled),
      ("result", result.json)]).compress)

end Hex.PrimalityProofProbe.PMinusOne
