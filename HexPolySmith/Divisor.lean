module

public import HexPolySmith.Diagonal

public section

/-! Determinantal divisors of polynomial matrices. -/

namespace Hex.PolyMatrix

universe u v

open Hex

/-- The square submatrix selected by increasing row and column tuples. -/
noncomputable def selectedMinor {R : Type u} {n m k : Nat}
    (A : Matrix R n m) (rows : Vector (Fin n) k) (cols : Vector (Fin m) k) :
    Matrix R k k :=
  Matrix.selectedSubmatrix A (Matrix.columnTupleVectorFn rows)
    (Matrix.columnTupleVectorFn cols)

/-- All `k × k` minors, with row and column sets in increasing order. -/
noncomputable def minors {F : Type u} [Lean.Grind.Field F] [DecidableEq F]
    {n m : Nat} (A : Matrix (DensePoly F) n m) (k : Nat) :
    List (DensePoly F) :=
  (Matrix.selectedColumnTuples k n).flatMap fun rows =>
    (Matrix.selectedColumnTuples k m).map fun cols =>
      Matrix.det (selectedMinor A rows cols)

private def gcdFold {F : Type u} [Lean.Grind.Field F] [DecidableEq F]
    (xs : List (DensePoly F)) : DensePoly F :=
  xs.foldl DensePoly.gcd 0

/-- The monic generator of the ideal generated by the `k × k` minors. -/
noncomputable def detDivisor {F : Type u} [Lean.Grind.Field F] [DecidableEq F]
    {n m : Nat} (A : Matrix (DensePoly F) n m) (k : Nat) : DensePoly F :=
  DensePoly.monicize (gcdFold (minors A k))

private theorem dvd_trans {F : Type u} [Lean.Grind.Field F] [DecidableEq F]
    {a b c : DensePoly F} (hab : a ∣ b) (hbc : b ∣ c) : a ∣ c := by
  rcases hab with ⟨r, hr⟩
  rcases hbc with ⟨s, hs⟩
  refine ⟨r * s, ?_⟩
  rw [hs, hr, DensePoly.mul_assoc_poly]

private theorem monic_eq_of_dvd_dvd {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {p q : DensePoly F} (hp : p.Monic) (hq : q.Monic)
    (hpq : p ∣ q) (hqp : q ∣ p) : p = q := by
  have hp0 : p ≠ 0 := by
    intro h
    change p.leadingCoeff = 1 at hp
    rw [h, DensePoly.leadingCoeff_zero] at hp
    exact Lean.Grind.Field.zero_ne_one hp
  have hq0 : q ≠ 0 := by
    intro h
    change q.leadingCoeff = 1 at hq
    rw [h, DensePoly.leadingCoeff_zero] at hq
    exact Lean.Grind.Field.zero_ne_one hq
  rcases hpq with ⟨a, ha⟩
  rcases hqp with ⟨b, hb⟩
  have ha0 : a ≠ 0 := by
    intro hz
    rw [hz, Lean.Grind.Semiring.mul_zero] at ha
    exact hq0 ha
  have hb0 : b ≠ 0 := by
    intro hz
    rw [hz, Lean.Grind.Semiring.mul_zero] at hb
    exact hp0 hb
  have hsa : q.size = p.size + a.size - 1 := by
    rw [ha]
    exact DensePoly.size_mul_field p a hp0 ha0
  have hsb : p.size = q.size + b.size - 1 := by
    rw [hb]
    exact DensePoly.size_mul_field q b hq0 hb0
  have hpa0 : 0 < p.size := by
    exact Nat.pos_of_ne_zero (fun hs => hp0 ((DensePoly.size_eq_zero_iff p).mp hs))
  have hqa0 : 0 < q.size := by
    exact Nat.pos_of_ne_zero (fun hs => hq0 ((DensePoly.size_eq_zero_iff q).mp hs))
  have haa0 : 0 < a.size := by
    exact Nat.pos_of_ne_zero (fun hs => ha0 ((DensePoly.size_eq_zero_iff a).mp hs))
  have hba0 : 0 < b.size := by
    exact Nat.pos_of_ne_zero (fun hs => hb0 ((DensePoly.size_eq_zero_iff b).mp hs))
  have hasa : a.size = 1 := by omega
  have haa : 0 < a.size := by omega
  have hlca : a.leadingCoeff = 1 := by
    have hprod : p.leadingCoeff * a.leadingCoeff ≠ (0 : F) := by
      rw [hp]
      intro hz
      rw [Lean.Grind.Semiring.one_mul] at hz
      exact DensePoly.leadingCoeff_ne_zero_of_pos_size a haa hz
    have hlc := DensePoly.leadingCoeff_mul p a hpa0 haa hprod
    rw [← ha, hq, hp, Lean.Grind.Semiring.one_mul] at hlc
    exact hlc.symm
  have haone : a = (1 : DensePoly F) := by
    rw [DensePoly.eq_C_leadingCoeff_of_size_one hasa, hlca]
    rfl
  rw [haone, DensePoly.mul_one_right_poly] at ha
  exact ha.symm

private theorem canonical_eq_of_dvd_dvd {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {p q : DensePoly F}
    (hp : p = 0 ∨ p.Monic) (hq : q = 0 ∨ q.Monic)
    (hpq : p ∣ q) (hqp : q ∣ p) : p = q := by
  rcases hp with rfl | hp
  · rcases hpq with ⟨a, ha⟩
    rw [DensePoly.zero_mul] at ha
    exact ha.symm
  · rcases hq with rfl | hq
    · rcases hqp with ⟨a, ha⟩
      rw [DensePoly.zero_mul] at ha
      exact ha
    · exact monic_eq_of_dvd_dvd hp hq hpq hqp

private theorem dvd_foldl_sum {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {β : Type v} (d : DensePoly F) (xs : List β)
    (f : β → DensePoly F) (hall : ∀ x ∈ xs, d ∣ f x) :
    d ∣ xs.foldl (fun acc x => acc + f x) 0 := by
  have aux : ∀ (ys : List β) (acc : DensePoly F), d ∣ acc →
      (∀ y ∈ ys, d ∣ f y) →
      d ∣ ys.foldl (fun z y => z + f y) acc := by
    intro ys
    induction ys with
    | nil =>
        intro acc hacc _hall
        exact hacc
    | cons y ys ih =>
        intro acc hacc hyall
        simp only [List.foldl_cons]
        apply ih
        · exact DensePoly.dvd_add_poly hacc (hyall y (by simp))
        · intro z hz
          exact hyall z (by simp [hz])
  exact aux xs 0 (DensePoly.dvd_zero_poly d) hall

private theorem selectedMinor_eq_columnTupleMatrix_selectedRows
    {R : Type u} {n m k : Nat} (A : Matrix R n m)
    (rows : Vector (Fin n) k) (cols : Vector (Fin m) k) :
    selectedMinor A rows cols =
      Matrix.columnTupleMatrix
        (Matrix.selectedRows A (Matrix.columnTupleVectorFn rows))
        (Matrix.columnTupleVectorFn cols) := by
  apply Matrix.ext_getElem
  intro i j
  rw [selectedMinor, Matrix.getElem_selectedSubmatrix,
    Matrix.getElem_columnTupleMatrix, Matrix.getElem_selectedRows]

private theorem dvd_orderedMinor {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m k : Nat} (A : Matrix (DensePoly F) n m)
    (d : DensePoly F) (rows : Vector (Fin n) k)
    (hrows : rows ∈ Matrix.selectedColumnTuples k n)
    (cols : Vector (Fin m) k)
    (hall : ∀ M ∈ minors A k, d ∣ M) :
    d ∣ Matrix.det (Matrix.columnTupleMatrix
      (Matrix.selectedRows A (Matrix.columnTupleVectorFn rows))
      (Matrix.columnTupleVectorFn cols)) := by
  by_cases hinj : Function.Injective (Matrix.columnTupleVectorFn cols)
  · let sorted := Matrix.sortInjTuple cols
    let perm := Matrix.sortInjPerm cols
    have hsorted : sorted ∈ Matrix.selectedColumnTuples k m :=
      Matrix.sortInjTuple_mem_selectedColumnTuples cols hinj
    have hperm : perm ∈ Matrix.permutationVectors k :=
      Matrix.sortInjPerm_mem_permutationVectors cols hinj
    have hminor : d ∣ Matrix.det (selectedMinor A rows sorted) := by
      apply hall
      unfold minors
      rw [List.mem_flatMap]
      refine ⟨rows, hrows, ?_⟩
      rw [List.mem_map]
      exact ⟨sorted, hsorted, rfl⟩
    rw [selectedMinor_eq_columnTupleMatrix_selectedRows] at hminor
    have hcols :
        Matrix.columnTupleVectorFn cols =
          fun i => sorted[perm[i]] := by
      funext i
      exact Matrix.cols_getElem_eq_sortInjTuple_sortInjPerm cols hinj i
    rw [hcols]
    rw [Matrix.det_columnTupleMatrix_compose_perm _ sorted perm hperm]
    exact DensePoly.dvd_mul_left_poly _ hminor
  · rw [Matrix.det_columnTupleMatrix_eq_zero_of_not_injective _ _ hinj]
    exact DensePoly.dvd_zero_poly d

/-- A common divisor of all `k`-minors of `A` divides every selected
`k`-minor after multiplying `A` on either side. This is the divisibility
form of rectangular Cauchy--Binet used by determinantal divisors. -/
private theorem dvd_selectedMinor_mul {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m l k : Nat} (A : Matrix (DensePoly F) n m)
    (B : Matrix (DensePoly F) m l) (d : DensePoly F)
    (rows : Vector (Fin n) k) (cols : Vector (Fin l) k)
    (hrows : rows ∈ Matrix.selectedColumnTuples k n)
    (hall : ∀ M ∈ minors A k, d ∣ M) :
    d ∣ Matrix.det (selectedMinor (A * B) rows cols) := by
  rw [selectedMinor]
  rw [Matrix.det_selectedSubmatrix_mul_eq_sum_columnTuples]
  apply dvd_foldl_sum
  intro mid _hmid
  apply DensePoly.dvd_mul_left_poly
  exact dvd_orderedMinor A d rows hrows mid hall

private theorem foldlGcd_dvd_acc {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] (xs : List (DensePoly F)) (acc : DensePoly F) :
    xs.foldl DensePoly.gcd acc ∣ acc := by
  induction xs generalizing acc with
  | nil => exact DensePoly.dvd_refl_poly acc
  | cons x xs ih =>
      simp only [List.foldl_cons]
      exact dvd_trans (ih (DensePoly.gcd acc x)) (DensePoly.gcd_dvd_left acc x)

private theorem foldlGcd_dvd_mem {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] (xs : List (DensePoly F)) (acc x : DensePoly F)
    (hx : x ∈ xs) :
    xs.foldl DensePoly.gcd acc ∣ x := by
  induction xs generalizing acc with
  | nil => exact absurd hx List.not_mem_nil
  | cons y ys ih =>
      simp only [List.foldl_cons]
      rcases List.mem_cons.mp hx with rfl | hx
      · exact dvd_trans (foldlGcd_dvd_acc ys (DensePoly.gcd acc x))
          (DensePoly.gcd_dvd_right acc x)
      · exact ih (DensePoly.gcd acc y) hx

private theorem dvd_foldlGcd {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] (d acc : DensePoly F) (xs : List (DensePoly F))
    (hacc : d ∣ acc) (hall : ∀ x ∈ xs, d ∣ x) :
    d ∣ xs.foldl DensePoly.gcd acc := by
  induction xs generalizing acc with
  | nil => exact hacc
  | cons x xs ih =>
      simp only [List.foldl_cons]
      apply ih (DensePoly.gcd acc x)
      · exact DensePoly.dvd_gcd d acc x hacc (hall x (by simp))
      · intro y hy
        exact hall y (by simp [hy])

/-- Characterisation of the determinantal divisor as the monic (or zero)
greatest common divisor of all selected minors. -/
theorem detDivisor_spec {F : Type u} [Lean.Grind.Field F] [DecidableEq F]
    {n m : Nat} (A : Matrix (DensePoly F) n m) (k : Nat) :
    (detDivisor A k = 0 ∨ (detDivisor A k).Monic)
      ∧ (∀ M ∈ minors A k, detDivisor A k ∣ M)
      ∧ (∀ d, (∀ M ∈ minors A k, d ∣ M) → d ∣ detDivisor A k) := by
  let xs := minors A k
  let g := gcdFold xs
  have hshape : DensePoly.monicize g = 0 ∨ (DensePoly.monicize g).Monic := by
    by_cases hg : g = 0
    · left
      rw [hg, DensePoly.monicize_zero]
    · exact Or.inr (DensePoly.monic_monicize hg)
  refine ⟨hshape, ?_, ?_⟩
  · intro M hM
    have hgM : g ∣ M := by
      exact foldlGcd_dvd_mem xs 0 M hM
    by_cases hg : g = 0
    · rcases hgM with ⟨q, hq⟩
      rw [hg, DensePoly.zero_mul] at hq
      subst M
      refine ⟨0, ?_⟩
      exact (Lean.Grind.Semiring.mul_zero _).symm
    · exact DensePoly.monicize_dvd_of_dvd hg hgM
  · intro d hd
    have hd0 : d ∣ (0 : DensePoly F) := by
      refine ⟨0, ?_⟩
      exact (Lean.Grind.Semiring.mul_zero d).symm
    have hdg : d ∣ g := dvd_foldlGcd d 0 xs hd0 hd
    exact dvd_trans hdg (DensePoly.dvd_monicize g)

private theorem detDivisor_dvd_mulRight {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m l : Nat} (A : Matrix (DensePoly F) n m)
    (B : Matrix (DensePoly F) m l) (k : Nat) :
    detDivisor A k ∣ detDivisor (A * B) k := by
  apply (detDivisor_spec (A * B) k).2.2
  intro M hM
  unfold minors at hM
  rw [List.mem_flatMap] at hM
  rcases hM with ⟨rows, hrows, hcols⟩
  rw [List.mem_map] at hcols
  rcases hcols with ⟨cols, hcols, rfl⟩
  exact dvd_selectedMinor_mul A B (detDivisor A k) rows cols hrows
    (detDivisor_spec A k).2.1

/-- Right multiplication by an explicitly invertible square matrix preserves
every determinantal divisor. -/
theorem detDivisor_mulRight {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m : Nat} (A : Matrix (DensePoly F) n m)
    (V Vinv : Matrix (DensePoly F) m m)
    (hV : V * Vinv = Matrix.identity m) (k : Nat) :
    detDivisor (A * V) k = detDivisor A k := by
  have hback : (A * V) * Vinv = A := by
    rw [Matrix.mul_assoc, hV, Matrix.mul_identity]
  have hdivBack : detDivisor (A * V) k ∣ detDivisor A k := by
    have h := detDivisor_dvd_mulRight (A * V) Vinv k
    rw [hback] at h
    exact h
  have hdivForward : detDivisor A k ∣ detDivisor (A * V) k :=
    detDivisor_dvd_mulRight A V k
  apply canonical_eq_of_dvd_dvd
  · exact (detDivisor_spec (A * V) k).1
  · exact (detDivisor_spec A k).1
  · exact hdivBack
  · exact hdivForward

private theorem selectedMinor_transpose {R : Type u} [Lean.Grind.CommRing R]
    {n m k : Nat} (A : Matrix R n m) (rows : Vector (Fin m) k)
    (cols : Vector (Fin n) k) :
    selectedMinor A.transpose rows cols = (selectedMinor A cols rows).transpose := by
  apply Matrix.ext_getElem
  intro i j
  simp only [selectedMinor, Matrix.getElem_selectedSubmatrix,
    Matrix.getElem_transpose]

private theorem detDivisor_dvd_transpose {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m : Nat} (A : Matrix (DensePoly F) n m) (k : Nat) :
    detDivisor A k ∣ detDivisor A.transpose k := by
  apply (detDivisor_spec A.transpose k).2.2
  intro M hM
  unfold minors at hM
  rw [List.mem_flatMap] at hM
  rcases hM with ⟨rows, hrows, hcols⟩
  rw [List.mem_map] at hcols
  rcases hcols with ⟨cols, hcols, rfl⟩
  rw [selectedMinor_transpose, Matrix.det_transpose]
  apply (detDivisor_spec A k).2.1
  unfold minors
  rw [List.mem_flatMap]
  refine ⟨cols, hcols, ?_⟩
  rw [List.mem_map]
  exact ⟨rows, hrows, rfl⟩

/-- Transpose preserves every determinantal divisor. -/
theorem detDivisor_transpose {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m : Nat} (A : Matrix (DensePoly F) n m) (k : Nat) :
    detDivisor A.transpose k = detDivisor A k := by
  apply canonical_eq_of_dvd_dvd
  · exact (detDivisor_spec A.transpose k).1
  · exact (detDivisor_spec A k).1
  · simpa using detDivisor_dvd_transpose A.transpose k
  · exact detDivisor_dvd_transpose A k

/-- Left multiplication by an explicitly invertible square matrix preserves
every determinantal divisor. -/
theorem detDivisor_mulLeft {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m : Nat} (A : Matrix (DensePoly F) n m)
    (U Uinv : Matrix (DensePoly F) n n)
    (hU : U * Uinv = Matrix.identity n) (k : Nat) :
    detDivisor (U * A) k = detDivisor A k := by
  have hother : Uinv * U = Matrix.identity n := Matrix.mul_eq_one_comm hU
  have hUt : U.transpose * Uinv.transpose = Matrix.identity n := by
    rw [← Matrix.transpose_mul_of_mul_comm Uinv U, hother, Matrix.transpose_identity]
  calc
    detDivisor (U * A) k = detDivisor (U * A).transpose k :=
      (detDivisor_transpose (U * A) k).symm
    _ = detDivisor (A.transpose * U.transpose) k := by
      rw [Matrix.transpose_mul_of_mul_comm]
    _ = detDivisor A.transpose k :=
      detDivisor_mulRight A.transpose U.transpose Uinv.transpose hUt k
    _ = detDivisor A k := detDivisor_transpose A k

private theorem selectedIndex_le {m k : Nat} (cols : Vector (Fin m) k)
    (hcols : Matrix.IsStrictlyIncreasingColumnTuple cols) (i : Fin k) :
    i.val ≤ cols[i].val := by
  have aux : ∀ t (ht : t < k), t ≤ cols[t]'ht := by
    intro t
    induction t with
    | zero => intro _ht; omega
    | succ t ih =>
        intro ht
        have ht' : t < k := by omega
        have hstep := hcols (⟨t, ht'⟩ : Fin k) (⟨t + 1, ht⟩ : Fin k) (by simp)
        have hprev := ih ht'
        change t ≤ (cols[(⟨t, ht'⟩ : Fin k)]).val at hprev
        change t + 1 ≤ (cols[(⟨t + 1, ht⟩ : Fin k)]).val
        omega
  exact aux i.val i.isLt

private theorem chain_dvd {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {r : Nat} (d : Vector (DensePoly F) r)
    (hchain : ∀ (i : Nat) (hi : i + 1 < r),
      d[i]'(by omega) ∣ d[i + 1])
    (i j : Nat) (hi : i < r) (hj : j < r) (hij : i ≤ j) :
    d[i]'hi ∣ d[j]'hj := by
  induction j with
  | zero =>
      have : i = 0 := by omega
      subst i
      exact DensePoly.dvd_refl_poly _
  | succ j ih =>
      by_cases heq : i = j + 1
      · subst i
        exact DensePoly.dvd_refl_poly _
      · have hij' : i ≤ j := by omega
        exact dvd_trans (ih (by omega) hij') (hchain j (by omega))

private theorem dvd_mul_pair {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {a b c d : DensePoly F}
    (hab : a ∣ b) (hcd : c ∣ d) : a * c ∣ b * d := by
  rcases hab with ⟨x, hx⟩
  rcases hcd with ⟨y, hy⟩
  refine ⟨x * y, ?_⟩
  rw [hx, hy]
  grind

private theorem finFoldl_mul_dvd {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {k : Nat} (a b : Fin k → DensePoly F)
    (h : ∀ i, a i ∣ b i) :
    Fin.foldl k (fun acc i => acc * a i) 1 ∣
      Fin.foldl k (fun acc i => acc * b i) 1 := by
  simp only [Fin.foldl_eq_finRange_foldl]
  have aux : ∀ (xs : List (Fin k)) (pa pb : DensePoly F), pa ∣ pb →
      xs.foldl (fun acc i => acc * a i) pa ∣
        xs.foldl (fun acc i => acc * b i) pb := by
    intro xs
    induction xs with
    | nil => intro pa pb hp; exact hp
    | cons i xs ih =>
        intro pa pb hp
        simp only [List.foldl_cons]
        exact ih _ _ (dvd_mul_pair hp (h i))
  exact aux (List.finRange k) 1 1 (DensePoly.dvd_refl_poly 1)

theorem take_foldl_eq_finFoldl {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {r : Nat} (d : Vector (DensePoly F) r)
    (k : Nat) (hk : k ≤ r) :
    (d.take k).foldl (fun acc p => acc * p) 1 =
      Fin.foldl k (fun acc i => acc * d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk)) 1 := by
  rw [← Vector.foldl_toList, Vector.toList_take, Fin.foldl_eq_finRange_foldl]
  have hright :
      (List.finRange k).foldl
          (fun acc i => acc * d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk)) 1 =
        ((List.finRange k).map
          fun i => d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk)).foldl
            (fun acc p => acc * p) 1 := by
    rw [List.foldl_map]
  rw [hright]
  congr 1
  apply List.ext_getElem
  · simp [hk]
  · intro i hi hj
    simp only [List.getElem_take, Vector.getElem_toList, List.getElem_map,
      List.getElem_finRange]
    rfl

private theorem monic_mul {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {p q : DensePoly F} (hp : p.Monic) (hq : q.Monic) :
    (p * q).Monic := by
  have hp0 : p ≠ 0 := by
    intro h
    change p.leadingCoeff = 1 at hp
    rw [h, DensePoly.leadingCoeff_zero] at hp
    exact Lean.Grind.Field.zero_ne_one hp
  have hq0 : q ≠ 0 := by
    intro h
    change q.leadingCoeff = 1 at hq
    rw [h, DensePoly.leadingCoeff_zero] at hq
    exact Lean.Grind.Field.zero_ne_one hq
  have hps : 0 < p.size :=
    Nat.pos_of_ne_zero (fun hs => hp0 ((DensePoly.size_eq_zero_iff p).mp hs))
  have hqs : 0 < q.size :=
    Nat.pos_of_ne_zero (fun hs => hq0 ((DensePoly.size_eq_zero_iff q).mp hs))
  have hprod : p.leadingCoeff * q.leadingCoeff ≠ (0 : F) := by
    rw [hp, hq, Lean.Grind.Semiring.one_mul]
    exact Ne.symm Lean.Grind.Field.zero_ne_one
  change (p * q).leadingCoeff = 1
  rw [DensePoly.leadingCoeff_mul p q hps hqs hprod, hp, hq,
    Lean.Grind.Semiring.one_mul]

theorem prefixProduct_monic {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {r : Nat} (d : Vector (DensePoly F) r)
    (hmonic : ∀ i : Fin r, d[i].Monic) (k : Nat) (hk : k ≤ r) :
    ((d.take k).foldl (fun acc p => acc * p) 1).Monic := by
  rw [take_foldl_eq_finFoldl d k hk, Fin.foldl_eq_finRange_foldl]
  have aux : ∀ (xs : List (Fin k)) (acc : DensePoly F), acc.Monic →
      (xs.foldl
        (fun z i => z * d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk)) acc).Monic := by
    intro xs acc hacc
    induction xs generalizing acc with
    | nil => exact hacc
    | cons i xs ih =>
        simp only [List.foldl_cons]
        exact ih _ (monic_mul hacc (hmonic ⟨i.val, Nat.lt_of_lt_of_le i.isLt hk⟩))
  apply aux
  exact DensePoly.leadingCoeff_one

private theorem prefixFactor_dvd_entry {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m r k : Nat} (d : Vector (DensePoly F) r)
    (hchain : ∀ (i : Nat) (hi : i + 1 < r),
      d[i]'(by omega) ∣ d[i + 1])
    (hk : k ≤ r) (rows : Vector (Fin n) k) (cols : Vector (Fin m) k)
    (hrows : rows ∈ Matrix.selectedColumnTuples k n)
    (i j : Fin k) :
    d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk) ∣
      (selectedMinor (Matrix.diagMatrix d n m) rows cols)[i][j] := by
  have hinc := (Matrix.mem_selectedColumnTuples_iff rows).mp hrows
  have hir := selectedIndex_le rows hinc i
  rw [selectedMinor, Matrix.getElem_selectedSubmatrix]
  change d[i.val]'(Nat.lt_of_lt_of_le i.isLt hk) ∣
    (Matrix.diagMatrix d n m)[rows[i]][cols[j]]
  by_cases heq : rows[i].val = cols[j].val
  · by_cases hr : rows[i].val < r
    · rw [Matrix.getElem_diagMatrix_of_eq d rows[i] cols[j] heq hr]
      exact chain_dvd d hchain i.val rows[i].val
        (Nat.lt_of_lt_of_le i.isLt hk) hr hir
    · rw [Matrix.getElem_diagMatrix_of_ge d rows[i] cols[j] (Nat.le_of_not_gt hr)]
      exact DensePoly.dvd_zero_poly _
  · rw [Matrix.getElem_diagMatrix_of_ne d rows[i] cols[j] heq]
    exact DensePoly.dvd_zero_poly _

private theorem prefixProduct_dvd_minor {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m r k : Nat} (d : Vector (DensePoly F) r)
    (hchain : ∀ (i : Nat) (hi : i + 1 < r),
      d[i]'(by omega) ∣ d[i + 1])
    (hk : k ≤ r) (rows : Vector (Fin n) k) (cols : Vector (Fin m) k)
    (hrows : rows ∈ Matrix.selectedColumnTuples k n) :
    (d.take k).foldl (fun acc p => acc * p) 1 ∣
      Matrix.det (selectedMinor (Matrix.diagMatrix d n m) rows cols) := by
  rw [take_foldl_eq_finFoldl d k hk]
  unfold Matrix.det
  apply dvd_foldl_sum
  intro perm _hperm
  unfold Matrix.detTerm
  apply DensePoly.dvd_mul_left_poly
  unfold Matrix.detProduct
  apply finFoldl_mul_dvd
  intro i
  simpa only [Matrix.getElem_pair_eq_nested] using
    prefixFactor_dvd_entry d hchain hk rows cols hrows i perm[i]

private theorem firstMinor_eq_prefixProduct {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m r k : Nat} (d : Vector (DensePoly F) r)
    (hk : k ≤ r) (hrn : r ≤ n) (hrm : r ≤ m) :
    Matrix.det (selectedMinor (Matrix.diagMatrix d n m)
      (Matrix.firstColumns k n (Nat.le_trans hk hrn))
      (Matrix.firstColumns k m (Nat.le_trans hk hrm))) =
      (d.take k).foldl (fun acc p => acc * p) 1 := by
  let rows := Matrix.firstColumns k n (Nat.le_trans hk hrn)
  let cols := Matrix.firstColumns k m (Nat.le_trans hk hrm)
  let M := selectedMinor (Matrix.diagMatrix d n m) rows cols
  have htri : ∀ i j : Fin k, j.val < i.val → M[i][j] = 0 := by
    intro i j hji
    unfold M selectedMinor rows cols
    rw [Matrix.getElem_selectedSubmatrix]
    change (Matrix.diagMatrix d n m)[
      (Matrix.firstColumns k n (Nat.le_trans hk hrn))[i]][
      (Matrix.firstColumns k m (Nat.le_trans hk hrm))[j]] = 0
    apply Matrix.getElem_diagMatrix_of_ne
    simp [Matrix.firstColumns]
    omega
  rw [Matrix.det_upperTriangular_eq_finFoldl_diag M htri]
  rw [take_foldl_eq_finFoldl d k hk]
  simp only [Fin.foldl_eq_finRange_foldl]
  apply List.foldl_congr
  intro acc i _hi
  unfold M selectedMinor rows cols
  rw [Matrix.getElem_selectedSubmatrix]
  change acc * (Matrix.diagMatrix d n m)[
      (Matrix.firstColumns k n (Nat.le_trans hk hrn))[i]][
      (Matrix.firstColumns k m (Nat.le_trans hk hrm))[i]] = acc * d[i.val]'
        (Nat.lt_of_lt_of_le i.isLt hk)
  rw [Matrix.getElem_diagMatrix_of_eq d _ _ (by simp [Matrix.firstColumns])
    (by simpa [Matrix.firstColumns] using Nat.lt_of_lt_of_le i.isLt hk)]
  congr 2
  simp [Matrix.firstColumns]

private theorem det_eq_zero_of_row_zero {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {k : Nat} (M : Matrix (DensePoly F) k k) (i : Fin k)
    (hrow : ∀ j : Fin k, M[i][j] = 0) : Matrix.det M = 0 := by
  have hscale : M.rowScale i 0 = M := by
    apply Matrix.ext_getElem
    intro r c
    rw [Matrix.getElem_rowScale]
    by_cases hri : r = i
    · rw [ite_eq_left hri]
      subst r
      rw [hrow]
      rw [DensePoly.zero_mul]
    · rw [ite_eq_right hri]
  have hdet := Matrix.det_rowScale M i (0 : DensePoly F)
  rw [hscale, DensePoly.zero_mul] at hdet
  exact hdet

private theorem minor_eq_zero_of_rank_lt {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m r k : Nat} (d : Vector (DensePoly F) r)
    (hrk : r < k) (rows : Vector (Fin n) k) (cols : Vector (Fin m) k)
    (hrows : rows ∈ Matrix.selectedColumnTuples k n) :
    Matrix.det (selectedMinor (Matrix.diagMatrix d n m) rows cols) = 0 := by
  let i : Fin k := ⟨r, hrk⟩
  apply det_eq_zero_of_row_zero _ i
  intro j
  rw [selectedMinor, Matrix.getElem_selectedSubmatrix]
  have hinc := (Matrix.mem_selectedColumnTuples_iff rows).mp hrows
  have hge : r ≤ rows[i].val := selectedIndex_le rows hinc i
  exact Matrix.getElem_diagMatrix_of_ge d rows[i] cols[j] hge

/-- Determinantal divisors of a monic divisibility-chain diagonal are its
prefix products, and vanish strictly past the represented rank. -/
theorem detDivisor_diagMatrix {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m r : Nat} (d : Vector (DensePoly F) r)
    (hrn : r ≤ n) (hrm : r ≤ m)
    (hmonic : ∀ i : Fin r, d[i].Monic)
    (hchain : ∀ (i : Nat) (hi : i + 1 < r),
      d[i]'(by omega) ∣ d[i + 1]) (k : Nat) :
    detDivisor (Matrix.diagMatrix d n m) k =
      if k ≤ r then (d.take k).foldl (fun acc p => acc * p) 1 else 0 := by
  split
  · rename_i hk
    let rows := Matrix.firstColumns k n (Nat.le_trans hk hrn)
    let cols := Matrix.firstColumns k m (Nat.le_trans hk hrm)
    have hrows : rows ∈ Matrix.selectedColumnTuples k n :=
      Matrix.firstColumns_mem_selectedColumnTuples k n (Nat.le_trans hk hrn)
    have hcols : cols ∈ Matrix.selectedColumnTuples k m :=
      Matrix.firstColumns_mem_selectedColumnTuples k m (Nat.le_trans hk hrm)
    have hmem : Matrix.det (selectedMinor (Matrix.diagMatrix d n m) rows cols) ∈
        minors (Matrix.diagMatrix d n m) k := by
      unfold minors
      rw [List.mem_flatMap]
      refine ⟨rows, hrows, ?_⟩
      rw [List.mem_map]
      exact ⟨cols, hcols, rfl⟩
    apply canonical_eq_of_dvd_dvd
    · exact (detDivisor_spec (Matrix.diagMatrix d n m) k).1
    · exact Or.inr (prefixProduct_monic d hmonic k hk)
    · rw [← firstMinor_eq_prefixProduct d hk hrn hrm]
      exact (detDivisor_spec (Matrix.diagMatrix d n m) k).2.1 _ hmem
    · apply (detDivisor_spec (Matrix.diagMatrix d n m) k).2.2
      intro M hM
      unfold minors at hM
      rw [List.mem_flatMap] at hM
      rcases hM with ⟨rs, hrs, hcs⟩
      rw [List.mem_map] at hcs
      rcases hcs with ⟨cs, _hcs, rfl⟩
      exact prefixProduct_dvd_minor d hchain hk rs cs hrs
  · rename_i hk
    have hrk : r < k := by omega
    apply canonical_eq_of_dvd_dvd
    · exact (detDivisor_spec (Matrix.diagMatrix d n m) k).1
    · exact Or.inl rfl
    · exact DensePoly.dvd_zero_poly _
    · apply (detDivisor_spec (Matrix.diagMatrix d n m) k).2.2
      intro M hM
      unfold minors at hM
      rw [List.mem_flatMap] at hM
      rcases hM with ⟨rs, hrs, hcs⟩
      rw [List.mem_map] at hcs
      rcases hcs with ⟨cs, _hcs, rfl⟩
      rw [minor_eq_zero_of_rank_lt d hrk rs cs hrs]
      exact DensePoly.dvd_zero_poly 0

/-- The determinantal-divisor specification of every certified Smith form,
including the vanishing range strictly above its rank. -/
theorem IsSNF.detDivisor_eq {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n m : Nat} {A : Matrix (DensePoly F) n m}
    {S : SmithData F n m} (h : IsSNF A S) (k : Nat) :
    detDivisor A k =
      if k ≤ S.rank then
        (S.diag.take k).foldl (fun acc p => acc * p) 1
      else 0 := by
  have hright : detDivisor (S.left * A * S.right) k =
      detDivisor (S.left * A) k :=
    detDivisor_mulRight (S.left * A) S.right S.rightInv h.right_inv k
  have hleft : detDivisor (S.left * A) k = detDivisor A k :=
    detDivisor_mulLeft A S.left S.leftInv h.left_inv k
  have hdiag := detDivisor_diagMatrix S.diag h.rank_le_n h.rank_le_m
    h.diag_monic h.chain k
  rw [← h.mul_eq] at hdiag
  exact hleft ▸ hright ▸ hdiag

private theorem selectedRows_eq_transpose_columnTuple {R : Type u}
    [Lean.Grind.CommRing R] {n : Nat} (A : Matrix R n n)
    (rows : Vector (Fin n) n) :
    Matrix.selectedRows A (Matrix.columnTupleVectorFn rows) =
      (Matrix.columnTupleMatrix A.transpose
        (Matrix.columnTupleVectorFn rows)).transpose := by
  apply Matrix.ext_getElem
  intro i j
  rw [Matrix.getElem_selectedRows, Matrix.getElem_transpose,
    Matrix.getElem_columnTupleMatrix, Matrix.getElem_transpose]

private theorem det_selectedMinor_full {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n : Nat} (A : Matrix (DensePoly F) n n)
    (rows cols : Vector (Fin n) n)
    (hrows : rows ∈ Matrix.selectedColumnTuples n n)
    (hcols : cols ∈ Matrix.selectedColumnTuples n n) :
    Matrix.det (selectedMinor A rows cols) =
      Matrix.detSign (R := DensePoly F) (Vector.ofFn (Matrix.columnTupleVectorFn cols)) *
        (Matrix.detSign (R := DensePoly F)
          (Vector.ofFn (Matrix.columnTupleVectorFn rows)) * Matrix.det A) := by
  rw [selectedMinor_eq_columnTupleMatrix_selectedRows]
  rw [Matrix.det_columnTupleMatrix_of_injective _ _
    (Matrix.mem_selectedColumnTuples_injective hcols)]
  rw [selectedRows_eq_transpose_columnTuple, Matrix.det_transpose]
  rw [Matrix.det_columnTupleMatrix_of_injective _ _
    (Matrix.mem_selectedColumnTuples_injective hrows), Matrix.det_transpose]

private theorem firstMinor_eq_matrix {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n : Nat} (A : Matrix (DensePoly F) n n) :
    selectedMinor A (Matrix.firstColumns n n (Nat.le_refl n))
      (Matrix.firstColumns n n (Nat.le_refl n)) = A := by
  apply Matrix.ext_getElem
  intro i j
  rw [selectedMinor, Matrix.getElem_selectedSubmatrix]
  change A[(Matrix.firstColumns n n (Nat.le_refl n))[i]][
    (Matrix.firstColumns n n (Nat.le_refl n))[j]] = A[i][j]
  simp [Matrix.firstColumns]

/-- For a square matrix, the top determinantal divisor is the monic
associate of its determinant. -/
theorem detDivisor_full {F : Type u} [Lean.Grind.Field F]
    [DecidableEq F] {n : Nat} (A : Matrix (DensePoly F) n n) :
    detDivisor A n = DensePoly.monicize (Matrix.det A) := by
  let first := Matrix.firstColumns n n (Nat.le_refl n)
  have hfirst : first ∈ Matrix.selectedColumnTuples n n :=
    Matrix.firstColumns_mem_selectedColumnTuples n n (Nat.le_refl n)
  have hmem : Matrix.det (selectedMinor A first first) ∈ minors A n := by
    unfold minors
    rw [List.mem_flatMap]
    refine ⟨first, hfirst, ?_⟩
    rw [List.mem_map]
    exact ⟨first, hfirst, rfl⟩
  have hshape : DensePoly.monicize (Matrix.det A) = 0 ∨
      (DensePoly.monicize (Matrix.det A)).Monic := by
    by_cases hdet : Matrix.det A = 0
    · left; rw [hdet, DensePoly.monicize_zero]
    · exact Or.inr (DensePoly.monic_monicize hdet)
  apply canonical_eq_of_dvd_dvd
  · exact (detDivisor_spec A n).1
  · exact hshape
  · have hd := (detDivisor_spec A n).2.1 _ hmem
    rw [firstMinor_eq_matrix A] at hd
    exact dvd_trans hd (DensePoly.dvd_monicize (Matrix.det A))
  · apply (detDivisor_spec A n).2.2
    intro M hM
    unfold minors at hM
    rw [List.mem_flatMap] at hM
    rcases hM with ⟨rows, hrows, hcols⟩
    rw [List.mem_map] at hcols
    rcases hcols with ⟨cols, hcols, rfl⟩
    rw [det_selectedMinor_full A rows cols hrows hcols]
    by_cases hdet : Matrix.det A = 0
    · rw [hdet, Lean.Grind.Semiring.mul_zero, Lean.Grind.Semiring.mul_zero]
      exact DensePoly.dvd_zero_poly _
    · apply DensePoly.monicize_dvd_of_dvd hdet
      refine ⟨Matrix.detSign (R := DensePoly F)
        (Vector.ofFn (Matrix.columnTupleVectorFn cols)) *
          Matrix.detSign (R := DensePoly F)
            (Vector.ofFn (Matrix.columnTupleVectorFn rows)), ?_⟩
      grind

end Hex.PolyMatrix
