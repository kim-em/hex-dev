public section

namespace HexGroebnerTheory
open scoped HexMvPolyTheory HexModArithTheory.ZMod64
namespace Certificate
open Hex.Groebner.Certificate

/-- Every indexed final pair has a bounded zero-remainder witness. -/
theorem checkPairs_sound {p n : Nat} [Hex.ZMod64.Bounds p] [Fact p.Prime]
    (order : Hex.Groebner.TermOrder) (basis : Array Polynomial)
    (pairs : Array (Array (Array Polynomial)))
    (canonical : ∀ a ∈ basis, Hex.MvPoly.Kernel.CanonicalMod p n a)
    (h : checkPairs p n order basis pairs = true) (i j : Fin basis.size) :
    (toMonomialOrder (order.cmp n)).IsRemainder
      ((toMonomialOrder (order.cmp n)).sPolynomial
        (HexMvPolyTheory.Kernel.denoteMod p (cmp := order.cmp n) basis[i])
        (HexMvPolyTheory.Kernel.denoteMod p (cmp := order.cmp n) basis[j]))
      (Set.range fun k : Fin basis.size =>
        HexMvPolyTheory.Kernel.denoteMod p (cmp := order.cmp n) basis[k]) 0 := by
  have hc : basis.toList.all (Hex.MvPoly.Kernel.isCanonicalMod p n) = true :=
    List.all_eq_true.mpr fun a ha => Hex.MvPoly.Kernel.isCanonicalMod_iff.mpr
      (canonical a (Array.mem_def.mpr ha))
  rw [checkPairs_eq p n order basis pairs hc] at h
  have hi := List.all_eq_true.mp (Bool.and_eq_true_iff.mp h).2 i (by simp)
  have hij := List.all_eq_true.mp hi j (by simp)
  cases hc : pairs[i.val]?.bind (fun row => row[j.val]?) with
  | none => simp [hc] at hij
  | some cofactors =>
    simp only [hc] at hij
    have reduction := checkReduction_sound order basis cofactors _ hij
    erw [sPolynomial_eq order (canonical _ (Array.getElem_mem i.isLt))
      (canonical _ (Array.getElem_mem j.isLt))] at reduction
    exact reduction

end Certificate

/-- Complete semantic postcondition, including the canonical decreasing array
order. The ideal is generated by the original inputs, not the proposed basis. -/
@[expose] def IsReducedBasis (context : Hex.Groebner.Context)
    (generators basis : Array Hex.Groebner.Certificate.Polynomial) : Prop :=
  letI : Fact context.field.modulus.toNat.Prime := ⟨fieldPrime context.field⟩
  let m := toMonomialOrder (context.order.cmp context.variables)
  let G := Set.range fun i : Fin basis.size => denote context basis[i]
  IsGroebnerBasis m G (Ideal.span (Set.range fun i : Fin generators.size => denote context generators[i])) ∧
    IsReduced m G ∧ ∀ i j : Fin basis.size, i.val < j.val →
      m.toSyn (m.degree (denote context basis[j])) < m.toSyn (m.degree (denote context basis[i]))

/-- Complete independent acceptance proves the reduced Gröbner basis of the
original ideal, with all final S-pair obligations and the specified output
order. There is no producer-provenance or native-provider hypothesis. -/
theorem checkBasis_sound (context : Hex.Groebner.Context)
    (generators basis : Array Hex.Groebner.Certificate.Polynomial)
    (certificate : Hex.Groebner.Certificate.Basis)
    (h : Hex.Groebner.checkBasis context generators basis certificate = true) :
    IsReducedBasis context generators basis := by
  let p := context.field.modulus.toNat
  let n := context.variables
  let order := context.order
  let := fieldBounds context.field
  let : Fact p.Prime := ⟨fieldPrime context.field⟩
  simp only [Hex.Groebner.checkBasis, Bool.and_eq_true] at h
  have forward := Certificate.checkContainment_sound p n (cmp := order.cmp n)
    generators basis certificate.forward h.1.1.1
  have backward := Certificate.checkContainment_sound p n (cmp := order.cmp n)
    basis generators certificate.backward h.1.1.2
  let F := Set.range fun i : Fin generators.size =>
    HexMvPolyTheory.Kernel.denoteMod p (cmp := order.cmp n) generators[i]
  let G := Set.range fun i : Fin basis.size =>
    HexMvPolyTheory.Kernel.denoteMod p (cmp := order.cmp n) basis[i]
  have fg : G ⊆ Ideal.span F := by
    rintro g ⟨i, rfl⟩
    exact forward.2.2 i
  have gf : F ⊆ Ideal.span G := by
    rintro f ⟨i, rfl⟩
    exact backward.2.2 i
  have ideals : Ideal.span G = Ideal.span F :=
    le_antisymm (Ideal.span_le.mpr fg) (Ideal.span_le.mpr gf)
  have groebner : IsGroebnerBasis (toMonomialOrder (order.cmp n)) G (Ideal.span G) := by
    apply (buchberger_iff _ G).mpr
    intro a b
    obtain ⟨i, hi⟩ := a.property
    obtain ⟨j, hj⟩ := b.property
    have reduction := Certificate.checkPairs_sound order basis certificate.pairs forward.2.1 h.2 i j
    simpa only [hi, hj] using reduction
  rw [ideals] at groebner
  exact ⟨groebner,
    Certificate.checkShape_reduced order basis forward.2.1 h.1.2,
    Certificate.checkShape_sorted order basis forward.2.1 h.1.2⟩

/-- Independently accepted outputs for the same original ideal are the same
reduced Gröbner basis as a set of formal polynomials. -/
theorem checkBasis_unique (context : Hex.Groebner.Context)
    (generators G H : Array Hex.Groebner.Certificate.Polynomial)
    (g : Hex.Groebner.Certificate.Basis) (h : Hex.Groebner.Certificate.Basis)
    (hg : Hex.Groebner.checkBasis context generators G g = true)
    (hh : Hex.Groebner.checkBasis context generators H h = true) :
    (Set.range fun i : Fin G.size => denote context G[i]) =
      (Set.range fun i : Fin H.size => denote context H[i]) := by
  let : Fact context.field.modulus.toNat.Prime := ⟨fieldPrime context.field⟩
  have left := checkBasis_sound context generators G g hg
  have right := checkBasis_sound context generators H h hh
  exact reduced_unique _ left.1 right.1 left.2.1 right.2.1

end HexGroebnerTheory
