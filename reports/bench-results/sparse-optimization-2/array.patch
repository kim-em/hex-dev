 def normalize (xs : List (Fin n)) : List (Fin n) :=
   unique (Hex.List.sort xs (fun a b => a ≤ b))
 
+/-- Map and normalize a compressed row. -/
+def mapRow (xs : Array (Fin n)) (f : Fin n → Fin n) : List (Fin n) :=
+  normalize (xs.toList.map f)
+
+/-- Keep mapped rows in arrays through sorting in compiled code. -/
+def mapRowArray (xs : Array (Fin n)) (f : Fin n → Fin n) : List (Fin n) :=
+  unique ((xs.map f).mergeSort (fun a b => a ≤ b)).toList
+
+@[csimp] theorem mapRow_eq_array : @mapRow = @mapRowArray := by
+  funext n xs f
+  simp [mapRow, mapRowArray, normalize, Hex.List.sort_eq, Array.toList_mergeSort]
+
 @[simp] theorem mem_normalize (a : Fin n) (xs : List (Fin n)) :
     a ∈ normalize xs ↔ a ∈ xs := by simp [normalize]
 
