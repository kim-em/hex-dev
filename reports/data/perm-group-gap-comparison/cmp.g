timeIt := function(f, reps) local t, best, i, r; best := infinity; for i in [1..reps] do t := NanosecondsSinceEpoch(); r := f(); t := NanosecondsSinceEpoch() - t; best := Minimum(best, t); od; return [r, Float(best / 10^6)]; end;
