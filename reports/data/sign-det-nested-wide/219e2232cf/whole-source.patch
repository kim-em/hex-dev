diff --git a/bench/HexSignDet/NestedTables.lean b/bench/HexSignDet/NestedTables.lean
new file mode 100644
index 0000000000..6755d6d3f2
--- /dev/null
+++ b/bench/HexSignDet/NestedTables.lean
@@ -0,0 +1,317 @@
+/-
