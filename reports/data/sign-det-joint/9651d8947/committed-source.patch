diff --git a/bench/HexSignDet/Joint.lean b/bench/HexSignDet/Joint.lean
new file mode 100644
index 000000000..7b086bed3
--- /dev/null
+++ b/bench/HexSignDet/Joint.lean
@@ -0,0 +1,140 @@
+/-
