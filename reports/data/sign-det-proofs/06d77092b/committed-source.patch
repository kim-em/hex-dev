+/-
+Copyright (c) 2026 Lean FRO, LLC. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+Authors: Kim Morrison
+-/
+module
+
+public import HexSignDetMathlib.ProofProbe.Inputs
+
+public section
+
+namespace Hex.SignDetMathlib.ProofProbe.D1.Accept
+open Hex.SignDet Hex.SignDetMathlib.ProofProbe.Inputs
+
+@[expose] def evidence : Dag Rat Nat := graph 1
+
+set_option maxRecDepth 65536 in
+set_option maxHeartbeats 4000000 in
+/-- Fresh ordinary-kernel replay of the supplied graph expression. -/
+theorem checked : check 1 evidence = true := by
+  simp only [check, Dag.check, Dag.replay?, Dag.step, evidence, graph, entries,
+    Replay.check, Node.check, checkMoment, queryPoly, Sturm.check,
+    TarskiCertificate.check, SignedRemainderChain.check,
+    ← Array.all_toList, Array.toList_range]
+  decide +kernel
+
+#print axioms checked
+
+end Hex.SignDetMathlib.ProofProbe.D1.Accept
