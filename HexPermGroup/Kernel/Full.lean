module

public import HexPermGroup.Kernel.Assemble

public section

namespace Hex.PermGroup

/-- Every permutation of the declared degree is generated by `S`. -/
@[expose] def GeneratesAll (S : Array (Perm n)) : Prop := ∀ p, Generated S p

namespace Kernel

open Hex.Kernel

/-- Check that the certificate covers every permutation fixing `fixed`.
Each orbit covers all points outside `fixed`, its transversal fixes `fixed`,
and at the end at most one point remains outside `fixed`. -/
@[expose] def full (n : Nat) (fixed : List Nat) : Certificate → Bool
  | [] => allRange n fun i => allRange n fun j =>
      fixed.contains i || fixed.contains j || Nat.beq i j
  | L :: rest =>
    allRange n (fun i => fixed.contains i || !(Nat.beq (field (width n) L.lookup i) 0)) &&
    allRange L.size (fun j => fixed.all fun b =>
      Nat.beq (field (width n) (L.reps.get j) b) b) &&
    full n (L.base :: fixed) rest

private theorem full_sound : ∀ (ls : Certificate) (fixed : List Nat),
    levelsOk n (width n) (ident n (width n)) ls = true →
    (∀ s ∈ headGens ls, ∃ σ, Rep n s σ) →
    full n fixed ls = true → ∀ p : Perm n,
    (∀ i : Fin n, i.val ∈ fixed → p.get i = i) → groupOf n ls p
  | [], fixed, _, _, hf, p, hp => by
    apply Span.empty.mpr
    apply Perm.ext
    intro i
    simp only [Perm.get_id]
    by_cases hi : i.val ∈ fixed
    · exact hp i hi
    · have hpi : (p.get i).val ∉ fixed := by
        intro hm
        have he := p.get_inj (hp (p.get i) hm).symm
        exact hi (he ▸ hm)
      simp only [full, allRange_iff, Bool.or_eq_true, List.contains_iff_mem,
        beq_eq_decide, decide_eq_true_eq] at hf
      rcases hf i.val i.isLt (p.get i).val (p.get i).isLt with (hm | hm) | he
      · exact False.elim (hi hm)
      · exact False.elim (hpi hm)
      · exact (Fin.ext he).symm
  | L :: rest, fixed, hok, hgens, hf, p, hp => by
    obtain ⟨⟨hs, hi, ht, hn⟩, hpair, hrest⟩ := levelsOk_cons.mp hok
    have base : LevelBase n L rest := ⟨hs, hi, ht, hn, hpair, hgens⟩
    have hgens' : ∀ s ∈ headGens rest, ∃ σ, Rep n s σ := by
      match hr : rest with
      | [] => simp [headGens]
      | L' :: rest' =>
        intro s hm
        obtain ⟨τ, hτ, -⟩ := base.next_gens rfl hm
        exact ⟨τ, hτ⟩
    have hyp : LevelHyp n L rest := { base with sift := (levels_sound rest hrest hgens').1 }
    simp only [full, Bool.and_eq_true, allRange_iff, List.all_eq_true,
      Bool.or_eq_true, List.contains_iff_mem, Bool.not_eq_true', beq_eq_decide,
      decide_eq_true_eq, decide_eq_false_iff_not] at hf
    obtain ⟨⟨hcover, hfix⟩, htail⟩ := hf
    let b : Fin n := ⟨L.base, base.base_lt⟩
    have hm : base.Ω (p.get b) := by
      by_cases hb : b.val ∈ fixed
      · rw [hp b hb]
        exact hyp.base_mem
      · rcases hcover (p.get b).val (p.get b).isLt with hm | hm
        · have he := p.get_inj (hp (p.get b) hm).symm
          exact False.elim (hb (he ▸ hm))
        · exact hm
    let j := base.idx (p.get b)
    have hj : j < L.size := base.idx_lt hm
    let q := (base.tr j).inv.comp p
    have hqb : q.get b = b := by
      apply (base.tr j).get_inj
      simp only [q, Perm.get_comp, Perm.get_inv_get]
      rw [base.tr_apply hj, base.pt_idx hm]
    have hqfix : ∀ i : Fin n, i.val ∈ L.base :: fixed → q.get i = i := by
      intro i hi
      rcases List.mem_cons.mp hi with he | hi
      · have hib : i = b := Fin.ext he
        simpa only [hib] using hqb
      · have hti : (base.tr j).get i = i :=
          Fin.ext ((base.rep_reps hj i).symm.trans (hfix j hj i.val hi))
        apply (base.tr j).get_inj
        simp only [q, Perm.get_comp, Perm.get_inv_get, hp i hi, hti]
    have hq := full_sound rest (L.base :: fixed) hrest hgens' htail q hqfix
    have hprod := Span.comp (base.tr_mem hj) (hyp.rest_le hq).1
    have he : (base.tr j).comp q = p := by
      ext i
      simp [q]
    rwa [he] at hprod

/-- A full accepted certificate proves that every permutation is generated. -/
theorem all_of_check {gs : List (Perm n)} {inputs : List Nat} {c : Certificate}
    (hS : gs.map pack = inputs) (h : check n inputs c = true)
    (hf : full n [] c = true) : GeneratesAll gs.toArray := by
  have hc := check_list hS h
  obtain ⟨hin, hlv⟩ := (check_iff _ _).mp hc
  have hgens : ∀ s ∈ headGens c, ∃ σ, Rep n s σ := by
    intro s hs
    simp only [inputsOk, Bool.and_eq_true, List.all_eq_true, List.any_eq_true,
      List.mem_map, Bool.or_eq_true, beq_eq_decide, decide_eq_true_eq] at hin
    obtain ⟨_, ⟨p, _, rfl⟩, hp⟩ := hin.2 s hs
    rcases hp with rfl | hp
    · exact ⟨p, rep_pack p⟩
    · exact ⟨p.inv, rep_inv (rep_pack p) hp⟩
  intro p
  exact (groupOf_iff_generated hc p).mp
    (full_sound c [] hlv hgens hf p (by simp))

end Kernel
end Hex.PermGroup
