module

public import HexPermGroup.Build

public section

/-! Removing redundant generators. -/

namespace Hex.PermGroup

/-- Keep `p` unless the complete chain for the generators kept so far already
accepts it; a kept generator extends the chain. -/
@[expose] def sieveStep (s : (T : Array (Perm n)) × Construction T 0) (p : Perm n) :
    (T : Array (Perm n)) × Construction T 0 :=
  if s.2.chain.accepts 0 p then s
  else ⟨s.1.push p, Build.extend 0 (Nat.zero_le n) s.1 s.2 p
    fun _ _ hx => absurd hx (Nat.not_lt_zero _)⟩

/-- The generators of `S`, in order, omitting each one generated by those kept
before it. The result generates the same group. Each kept generator at least
doubles the group generated so far, so at most `log₂` of its order are kept. -/
@[expose] def sieve (S : Array (Perm n)) : Array (Perm n) :=
  (S.foldl sieveStep ⟨#[], Build.empty 0 (Nat.zero_le n)⟩).1

theorem generated_sieve (S : Array (Perm n)) (p : Perm n) :
    Generated (sieve S) p ↔ Generated S p := by
  have h := Array.foldl_induction
    (motive := fun i (s : (T : Array (Perm n)) × Construction T 0) =>
      (∀ x ∈ s.1, x ∈ S) ∧ ∀ j (hj : j < i) (hjS : j < S.size), Generated s.1 S[j])
    (init := ⟨#[], Build.empty 0 (Nat.zero_le n)⟩) (f := sieveStep)
    (as := S) ⟨by simp, fun j hj => absurd hj (Nat.not_lt_zero _)⟩ ?step
  · obtain ⟨hsub, hall⟩ := h
    constructor
    · exact Generated.mono fun x hx => .generator (hsub x hx)
    · apply Generated.mono
      intro x hx
      obtain ⟨j, hj, rfl⟩ := Array.mem_iff_getElem.mp hx
      exact hall j hj hj
  · intro i s ⟨hsub, hall⟩
    unfold sieveStep
    split
    · rename_i hacc
      refine ⟨hsub, fun j hj hjS => ?_⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
      · exact hall j hj hjS
      · exact (s.2.accepts_iff _).mp hacc
    · refine ⟨fun x hx => ?_, fun j hj hjS => ?_⟩
      · rcases Array.mem_push.mp hx with hx | rfl
        · exact hsub x hx
        · exact Array.getElem_mem i.isLt
      · rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
        · exact Generated.mono (fun x hx => .generator (Array.mem_push_of_mem _ hx))
            (hall j hj hjS)
        · exact .generator (by simp)

end Hex.PermGroup
