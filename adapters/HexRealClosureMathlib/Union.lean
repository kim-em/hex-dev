module

public import HexRealClosureMathlib.Ambient
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.Algebra.Order.Field.Subfield

public section

namespace Hex.RealClosure.Union
open Polynomial IntermediateField

variable (B : Type u) (R : Type v) [Field B] [Field R] [Algebra B R]

/-- All elements algebraic over the fixed base in the supplied ambient field. -/
noncomputable abbrev field : IntermediateField B R :=
  algebraicClosure B R

abbrev Carrier : Type v := field B R

variable {B R}

/-- Inclusion into the supplied ambient, with the prescribed base map. -/
noncomputable abbrev inclusion : Carrier B R →ₐ[B] R := (field B R).val

/-- The image consists exactly of the elements algebraic over the base. -/
theorem inclusion_range : Set.range (inclusion (B := B) (R := R)) =
    {x : R | IsAlgebraic B x} := by
  ext x
  constructor
  · rintro ⟨value, rfl⟩
    exact mem_algebraicClosure_iff.mp value.property
  · intro algebraic
    exact ⟨⟨x, mem_algebraicClosure_iff.mpr algebraic⟩, rfl⟩

/-- Membership uses the prescribed base algebra map. -/
theorem mem_iff (x : R) : x ∈ field B R ↔ IsAlgebraic B x :=
  mem_algebraicClosure_iff

/-- Every element of the union is algebraic over its fixed base. -/
theorem algebraic (x : Carrier B R) : IsAlgebraic B x :=
  Algebra.IsAlgebraic.isAlgebraic x

/-- A root over the union is algebraic over the original base. -/
theorem root_mem (p : Polynomial (Carrier B R)) (nonzero : p ≠ 0) (x : R)
    (root : (p.map (algebraMap (Carrier B R) R)).IsRoot x) : x ∈ field B R := by
  have hx : IsAlgebraic (Carrier B R) x := ⟨p, nonzero, by
    simpa only [IsRoot.def, eval_map, aeval_def] using root⟩
  exact mem_algebraicClosure_iff'.mpr (isIntegral_trans x hx.isIntegral)

/-- The field generated by finitely many prescribed ambient elements. -/
noncomputable def adjoin (generators : Finset R) : IntermediateField B R :=
  IntermediateField.adjoin B (generators : Set R)

/-- Every prescribed generator lies in its finite adjunction. -/
theorem mem_adjoin (generators : Finset R) (x : R) (member : x ∈ generators) :
    x ∈ adjoin (B := B) generators := IntermediateField.subset_adjoin B _ member

/-- A finite algebraic adjunction remains inside the union. -/
theorem adjoin_le (generators : Finset R)
    (algebraic : ∀ x ∈ generators, IsAlgebraic B x) : adjoin generators ≤ field B R := by
  exact IntermediateField.adjoin_le_iff.mpr fun x hx => (mem_iff x).mpr (algebraic x hx)

/-- Each finite adjunction of union elements is a finite extension of the base. -/
theorem adjoin_finite (generators : Finset R)
    (algebraic : ∀ x ∈ generators, IsAlgebraic B x) :
    FiniteDimensional B (adjoin (B := B) generators) := by
  exact IntermediateField.finiteDimensional_adjoin fun x hx => (algebraic x hx).isIntegral

/-- Every union element belongs to a finite compatible extension, and conversely. -/
theorem mem_iff_exists (x : R) :
    (∃ generators : Finset R, (∀ y ∈ generators, IsAlgebraic B y) ∧
      x ∈ adjoin (B := B) generators) ↔ x ∈ field B R := by
  classical
  constructor
  · rintro ⟨generators, algebraic, member⟩
    exact adjoin_le generators algebraic member
  · intro member
    refine ⟨{x}, ?_, ?_⟩
    · simpa using (mem_iff x).mp member
    · exact IntermediateField.subset_adjoin B _ (by simp)

/-- Two finite compatible extensions lie in one finite compatible extension. -/
theorem common_extension (left right : Finset R)
    (leftAlgebraic : ∀ x ∈ left, IsAlgebraic B x)
    (rightAlgebraic : ∀ x ∈ right, IsAlgebraic B x) :
    ∃ common : IntermediateField B R,
      FiniteDimensional B common ∧ common ≤ field B R ∧
      adjoin (B := B) left ≤ common ∧ adjoin (B := B) right ≤ common := by
  classical
  have all : ∀ x ∈ left ∪ right, IsAlgebraic B x := by
    intro x member
    rcases Finset.mem_union.mp member with member | member
    · exact leftAlgebraic x member
    · exact rightAlgebraic x member
  refine ⟨adjoin (B := B) (left ∪ right), adjoin_finite _ all, adjoin_le _ all, ?_, ?_⟩
  · exact IntermediateField.adjoin.mono _ _ _ (by intro x hx; exact Finset.mem_union.mpr (.inl hx))
  · exact IntermediateField.adjoin.mono _ _ _ (by intro x hx; exact Finset.mem_union.mpr (.inr hx))

/-- If the supplied ambient extension is algebraic, the union is the whole ambient. -/
theorem eq_top [Algebra.IsAlgebraic B R] : field B R = ⊤ :=
  (algebraicClosure.eq_top_iff B R).mpr inferInstance

section Order
variable [LinearOrder R]

/-- The inclusion uses exactly the ambient order. -/
theorem inclusion_lt (x y : Carrier B R) :
    inclusion x < inclusion y ↔ x < y := Iff.rfl

/-- A prescribed ordered base embedding retains its order in the union. -/
theorem base_lt [LinearOrder B] (ordered : StrictMono (algebraMap B R)) (a b : B) :
    algebraMap B (Carrier B R) a < algebraMap B (Carrier B R) b ↔ a < b := by
  change algebraMap B R a < algebraMap B R b ↔ a < b
  exact ordered.lt_iff_lt

variable [IsStrictOrderedRing R]

/-- The union inherits the order and field operations of the supplied ambient. -/
instance : IsStrictOrderedRing (Carrier B R) :=
  inferInstanceAs (IsStrictOrderedRing (field B R).toSubfield)

variable [IsRealClosed R]

/-- Nonnegative union elements have square roots in the same union. -/
theorem square {x : Carrier B R} (nonnegative : 0 ≤ x) : IsSquare x := by
  obtain ⟨r, hr⟩ := IsSquare.of_nonneg (show (0 : R) ≤ x from nonnegative)
  have root : ((X ^ 2 - C x).map (algebraMap (Carrier B R) R)).IsRoot r := by
    simp only [IsRoot.def, eval_map, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
    change r ^ 2 - (x : R) = 0
    rw [pow_two, ← hr, sub_self]
  let value : Carrier B R := ⟨r, root_mem (X ^ 2 - C x) (X_pow_sub_C_ne_zero (by decide) x) r root⟩
  exact ⟨value, Subtype.ext hr⟩

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- An odd-degree polynomial over the union has a root in the same union. -/
theorem odd_root {p : Polynomial (Carrier B R)} (odd : Odd p.natDegree) :
    ∃ x, p.IsRoot x := by
  have nonzero : p ≠ 0 := by
    intro zero
    simp [zero] at odd
  have mapped : Odd (p.map (algebraMap (Carrier B R) R)).natDegree := by
    rwa [natDegree_map_eq_of_injective (algebraMap (Carrier B R) R).injective]
  obtain ⟨x, root⟩ := IsRealClosed.exists_isRoot_of_odd_natDegree mapped
  refine ⟨⟨x, root_mem p nonzero x root⟩, ?_⟩
  apply (algebraMap (Carrier B R) R).injective
  simpa only [IsRoot.def, map_zero, ← eval₂_at_apply, eval_map, IntermediateField.algebraMap_apply] using root

/-- The relative algebraic union is real closed by square and odd-root closure. -/
theorem realClosed : IsRealClosed (Carrier B R) :=
  IsRealClosed.of_linearOrderedField square odd_root

end Order
end Hex.RealClosure.Union

namespace Hex.RealClosure.Ambient
variable {B : Type u} [Field B] [LinearOrder B]

/-- Restrict a supplied real closed field to its relative algebraic union.
The prescribed base embedding must preserve the source order. This produces
the algebraic ambient needed by the existing enlargement interface. -/
@[expose] noncomputable def ofUnion (R : Type u) [Field R] [LinearOrder R]
    [IsStrictOrderedRing R] [IsRealClosed R] [Algebra B R]
    (ordered : StrictMono (algebraMap B R)) : Ambient B where
  Carrier := Union.Carrier B R
  field := inferInstance
  order := inferInstance
  ordered := inferInstance
  closed := Union.realClosed
  inclusion := algebraMap B (Union.Carrier B R)
  monotone := fun a b less => (Union.base_lt ordered a b).mpr less
  algebraic x := by
    obtain ⟨p, nonzero, root⟩ := Union.algebraic x
    exact ⟨p, nonzero, root⟩

/-- Restriction preserves the actual original base map into the supplied ambient. -/
theorem ofUnion_inclusion (R : Type u) [Field R] [LinearOrder R]
    [IsStrictOrderedRing R] [IsRealClosed R] [Algebra B R]
    (ordered : StrictMono (algebraMap B R)) (a : B) :
    Union.inclusion ((ofUnion R ordered).inclusion a) = algebraMap B R a := rfl

/-- The proved algebraic ambient is its own relative algebraic union, using
its actual selected inclusion to give the base algebra structure. -/
theorem union_eq_top (ambient : Ambient B) :
    let _ : Algebra B ambient.Carrier := ambient.inclusion.toAlgebra
    Union.field B ambient.Carrier = ⊤ := by
  let _ : Algebra B ambient.Carrier := ambient.inclusion.toAlgebra
  let _ : Algebra.IsAlgebraic B ambient.Carrier := ⟨fun x => by
    obtain ⟨p, nonzero, root⟩ := ambient.algebraic x
    exact ⟨p, nonzero, root⟩⟩
  exact Union.eq_top

end Hex.RealClosure.Ambient

