/-- C(347, 2) has a generator of order 120408. -/
theorem primitive_347_2 :
    Primitive 347 2 supportedEntry_347_2 [2, 3, 29, 173] [3, 1, 1, 1] where
  primes := by
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hq
    · exact factorPrime_2
    rcases List.mem_cons.mp hq with rfl | hq
    · exact factorPrime_3
    rcases List.mem_cons.mp hq with rfl | hq
    · exact factorPrime_29
