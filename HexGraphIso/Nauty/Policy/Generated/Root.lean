namespace Hex.GraphIso.Nauty.Max

/-- The actual nonempty root generates every graph automorphism from its
own emitted trace, assuming only strictly smaller maximum contracts. -/
theorem root_generates {n k : Nat} (G : Colored n k) (hn0 : 0 < n)
    (hn : ∀ f, f < n + 2 → (contract G 100).nodeValid f
      (Generic.nodeCall { g := rowsOf G } (n + 2) 100 f))
    {p : Perm n} (hp : IsIso G G p) :
    Perm.Generated ((Nauty.runColoredTraced G).autos.toList.filterMap (autom? G)) p := by
  obtain ⟨last, leaf, hpath⟩ := initial_path G hn0
  have hrun : runState n (rowsOf G) (initialPartition G).1 (initialPartition G).2 =
      Nauty.node true { g := rowsOf G } (n + 2) 100 (n + 2) 1 (initialPartition G).2.length
        (initial n (initialPartition G).1 (initialPartition G).2) := by
    rw [runState, ite_eq_right (by simpa using Nat.ne_of_gt hn0)]
  have htrace := Generation.realized_trace (runState_safe G hn0)
  rw [hrun] at htrace
  have hh := firstPath_generates hpath hn (root_input G hn0) (base := []) (by
    intro b
    simp only [initial, VSet.mem_empty, Bool.false_eq_true, List.not_mem_nil]) htrace p hp (Perm.Fixes.nil p)
  rw [← hrun] at hh
  exact hh

/-- The empty graph's automorphism is generated by the empty word. -/
theorem zero_generates {k : Nat} (G : Colored 0 k) (p : Perm 0) :
    Perm.Generated ((Nauty.runColoredTraced G).autos.toList.filterMap (autom? G)) p := by
  have he : p = Perm.id 0 := Perm.ext (fun v => Fin.elim0 v)
  rw [he]
  exact .id

end Hex.GraphIso.Nauty.Max
