namespace Hex.GraphIso.Nauty

/-- The emitted arrays are checked automorphisms of the original coloured graph. -/
theorem emitted_admitted (G : Colored n k) {γ : Array Nat}
    (hγ : γ ∈ (runColoredTraced G).emitted.toList) : ∃ p, autom? G γ = some p := by
  have hs := (Emission.run_valid n (rowsOf G) (initialPartition G).1 (initialPartition G).2).sublist
  have hm : γ ∈ (runColoredTraced G).autos := Array.mem_toList_iff.mp (hs.subset hγ)
  exact Aut.admit_root (runColoredTraced_checked G hm) (runColoredTraced_stab G hm)

end Hex.GraphIso.Nauty

namespace Hex.GraphIso.Nauty.Max

/-- The actual nonempty root generates every graph automorphism from its
own emissions, assuming only strictly smaller maximum contracts. -/
theorem root_generates {n k : Nat} (G : Colored n k) (hn0 : 0 < n)
    (hn : ∀ f, f < n + 2 → (contract G 100).nodeValid f
      (Generic.nodeCall { g := rowsOf G } (n + 2) 100 f))
    {p : Perm n} (hp : IsIso G G p) :
    Perm.Generated ((Nauty.runColoredTraced G).emitted.toList.filterMap (autom? G)) p := by
  obtain ⟨last, leaf, hpath⟩ := initial_path G hn0
  have hrun : runState n (rowsOf G) (initialPartition G).1 (initialPartition G).2 =
      Nauty.node true { g := rowsOf G } (n + 2) 100 (n + 2) 1 (initialPartition G).2.length
        (initial n (initialPartition G).1 (initialPartition G).2) := by
    rw [runState, ite_eq_right (by simpa using Nat.ne_of_gt hn0)]
  have htrace := Generation.realized_trace (runState_safe G hn0)
  let gs := (Nauty.runColoredTraced G).emitted.toList.filterMap (autom? G)
  have hemit : Generation.Realizes G gs (Nauty.runColoredTraced G).emitted.toList := by
    intro γ hγ
    obtain ⟨p, hp⟩ := emitted_admitted G hγ
    exact ⟨p, .mem (List.mem_filterMap.mpr ⟨γ, hγ, hp⟩), autom?_isIso hp, autom?_val_get hp⟩
  change Generation.Realizes G gs
    (runState n (rowsOf G) (initialPartition G).1 (initialPartition G).2).2.emitted.toList at hemit
  rw [hrun] at htrace hemit
  have hbase : ∀ b : Fin n, (initial n (initialPartition G).1 (initialPartition G).2).fixedpts.mem b.val = true ↔
      b ∈ ([] : List (Fin n)) := by
    intro b
    simp only [initial, VSet.mem_empty, Bool.false_eq_true, List.not_mem_nil]
  have hreal := firstPath_realizes hpath hn (root_input G hn0) hbase htrace hemit Emission.Realization.initial
  exact firstPath_generates hpath hn (root_input G hn0) hbase hreal.trace p hp (Perm.Fixes.nil p)

/-- The empty graph's automorphism is generated by the empty word. -/
theorem zero_generates {k : Nat} (G : Colored 0 k) (p : Perm 0) :
    Perm.Generated ((Nauty.runColoredTraced G).emitted.toList.filterMap (autom? G)) p := by
  have he : p = Perm.id 0 := Perm.ext (fun v => Fin.elim0 v)
  rw [he]
  exact .id

end Hex.GraphIso.Nauty.Max
