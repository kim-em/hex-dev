namespace Hex.GraphIso.Nauty.Generation

variable {n k : Nat}

/-- A carrier is generated by the supplied final list and fixes the
active base. The list is independent of either search implementation. -/
def Carries (G : Colored n k) (gs : List (Perm n)) (base : List (Fin n)) (u v : Fin n) : Prop :=
  ∃ p, Perm.Generated gs p ∧ IsIso G G p ∧ Perm.Fixes base p ∧ p.get u = v

namespace Carries

variable {G : Colored n k} {gs : List (Perm n)} {base : List (Fin n)} {u v w : Fin n}

theorem refl (G : Colored n k) (gs : List (Perm n)) (base : List (Fin n)) (u : Fin n) :
    Carries G gs base u u := ⟨Perm.id n, .id, IsIso.refl G, Perm.Fixes.id base, by simp⟩

theorem trans (h : Carries G gs base u v) (h' : Carries G gs base v w) : Carries G gs base u w := by
  obtain ⟨p, hp, hi, hf, hv⟩ := h
  obtain ⟨q, hq, hj, hg, hw⟩ := h'
  exact ⟨q.comp p, hq.comp hp, hi.trans hj, hg.comp hf, by simp [hv, hw]⟩

theorem symm (h : Carries G gs base u v) : Carries G gs base v u := by
  obtain ⟨p, hp, hi, hf, rfl⟩ := h
  exact ⟨p.inv, hp.inv, hi.symm, hf.inv, by simp⟩

theorem orbit (h : Carries G gs base u v) : Aut.Orbit G base u v := by
  obtain ⟨p, _, hi, hf, hv⟩ := h
  exact ⟨p, hi, hf, hv⟩

/-- Retaining the emitted generators retains their carrier words. -/
theorem mono {more : List (Perm n)} (h : Carries G gs base u v)
    (hsub : ∀ p ∈ gs, p ∈ more) : Carries G more base u v := by
  obtain ⟨p, hp, hi, hf, hv⟩ := h
  exact ⟨p, hp.mono hsub, hi, hf, hv⟩

end Carries

/-- Every recorded array is represented in the supplied generated group,
with its exact pointwise action and colour preservation. -/
def Realizes (G : Colored n k) (gs : List (Perm n)) (store : List (Array Nat)) : Prop :=
  ∀ γ ∈ store, ∃ p, Perm.Generated gs p ∧ IsIso G G p ∧
    ∀ v : Fin n, (p.get v).val = γ[v.val]!

/-- Restricting a containing trace preserves all admission witnesses. -/
theorem Realizes.mono {G : Colored n k} {gs : List (Perm n)} {before after : List (Array Nat)}
    (h : Realizes G gs after) (hsub : ∀ γ ∈ before, γ ∈ after) : Realizes G gs before :=
  fun γ hγ => h γ (hsub γ hγ)

/-- A checked search output realizes its own filtered trace. This uses
only array admission and its initial-colour invariant. -/
theorem realized_trace {G : Colored n k} {st : Search n}
    (h : RunInv G { g := rowsOf G } st) :
    Realizes G (st.genTrace.toList.filterMap (autom? G)) st.genTrace.toList := by
  intro γ hγ
  have hm : γ ∈ st.genTrace := by simpa using hγ
  obtain ⟨p, hp⟩ := Aut.admit_root (h.trace γ hm) (h.colors γ hm)
  exact ⟨p, .mem (List.mem_filterMap.mpr ⟨γ, hγ, hp⟩), autom?_isIso hp, autom?_val_get hp⟩

/-- A word in the retained trace acts as a generated colour-preserving
permutation, including repeated and redundant generators. -/
theorem Realizes.word {G : Colored n k} {gs : List (Perm n)} :
    ∀ (w : List (Array Nat)), Realizes G gs w →
      ∃ p, Perm.Generated gs p ∧ IsIso G G p ∧
        ∀ v : Fin n, (p.get v).val = applyWord w v.val
  | [], _ => ⟨Perm.id n, .id, IsIso.refl G, fun v => by simp [applyWord]⟩
  | γ :: w, hw => by
    obtain ⟨p, hp, hi, hv⟩ := hw γ (List.mem_cons_self ..)
    obtain ⟨q, hq, hj, hqv⟩ := Realizes.word w (hw.mono (fun _ h => List.mem_cons_of_mem _ h))
    refine ⟨q.comp p, hq.comp hp, hi.trans hj, fun v => ?_⟩
    rw [Perm.get_comp, hqv, hv]
    rfl

private theorem word_fixed {w : List (Array Nat)} {v : Nat}
    (h : ∀ γ ∈ w, γ[v]! = v) : applyWord w v = v := by
  induction w with
  | nil => rfl
  | cons γ w ih =>
    change applyWord w γ[v]! = v
    rw [h γ (by simp)]
    exact ih (fun δ hδ => h δ (by simp [hδ]))

/-- Recorded words fixing the active base supply generated carriers. -/
theorem carries_word {G : Colored n k} {gs : List (Perm n)} {base : List (Fin n)} {u v : Fin n}
    {w : List (Array Nat)} (htrace : Realizes G gs w)
    (hfix : ∀ γ ∈ w, ∀ b ∈ base, γ[b.val]! = b.val)
    (hmap : applyWord w u.val = v.val) : Carries G gs base u v := by
  obtain ⟨p, hp, hi, hv⟩ := htrace.word w
  refine ⟨p, hp, hi, ?_, Fin.ext ((hv u).trans hmap)⟩
  intro b hb
  exact Fin.ext ((hv b).trans (word_fixed fun γ hγ => hfix γ hγ b hb))

/-- An orbit pointer is a generated carrier when its actual trace fixes
the active base and is included in the final containing trace. -/
theorem carries_pointer {G : Colored n k} {gs : List (Perm n)} {base : List (Fin n)}
    {store : List (Array Nat)} {orbits : Array Nat} {v : Fin n}
    (hsound : OrbSound (OrbConn store n) orbits n) (htrace : Realizes G gs store)
    (hfix : ∀ γ ∈ store, ∀ b ∈ base, γ[b.val]! = b.val) :
    ∃ u : Fin n, u.val = orbits[v.val]! ∧ u.val ≤ v.val ∧ Carries G gs base v u := by
  obtain ⟨hle, _, hu, w, hw, hmap⟩ := hsound.2 v.val v.isLt
  exact ⟨⟨orbits[v.val]!, hu⟩, rfl, hle,
    carries_word (htrace.mono hw) (fun γ hγ => hfix γ (hw γ hγ)) hmap⟩

/-- A returned scatter supplies the generated carrier between its
reference vertex and the chosen child vertex. -/
theorem carries_label {G : Colored n k} {gs : List (Perm n)} {base : List (Fin n)}
    {ctx : Ctx n} {ref cur : Array Nat} {store : Array (Array Nat)}
    {pos : Nat} {u v : Fin n} (h : LabelCarrier ctx ref cur store)
    (htrace : Realizes G gs store.toList)
    (hfix : ∀ γ ∈ store, ∀ b ∈ base, γ[b.val]! = b.val)
    (hpos : pos < n) (href : ref[pos]! = u.val) (hcur : cur[pos]! = v.val) :
    Carries G gs base u v := by
  obtain ⟨γ, hmem, _, hmap⟩ := h
  apply carries_word (w := [γ])
  · apply htrace.mono
    intro δ hδ
    rw [List.mem_singleton.mp hδ]
    simpa using hmem
  · intro δ hδ
    rw [List.mem_singleton.mp hδ]
    exact hfix γ hmem
  · simpa only [applyWord, List.foldl_cons, List.foldl_nil, href, hcur] using hmap pos hpos

end Hex.GraphIso.Nauty.Generation
