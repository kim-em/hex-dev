namespace Hex.GraphIso.Nauty.Sparse

/-- Decode exactly the permutations reported by the native sparse traversal. -/
@[expose] def State.emittedGenerators (st : State n) : List (Perm n) :=
  st.emitted.toList.filterMap (Perm.ofNatArray? n)

theorem runColored_emissions_valid (G : GraphIso.Sparse.Colored n k) :
    Emission.Valid (Emission.log (runColored G)) :=
  emissions_valid (.ofGraph G.graph) _ _

private theorem emitted_mem_trace (G : GraphIso.Sparse.Colored n k) {γ : Array Nat}
    (hm : γ ∈ (runColored G).emitted.toList) : γ ∈ (runColored G).genTrace :=
  Array.mem_toList_iff.mp ((runColored_emissions_valid G).sublist.subset hm)

theorem emitted_isIso {G : GraphIso.Sparse.Colored n k} {p : Perm n}
    (hp : p ∈ (runColored G).emittedGenerators) : GraphIso.Sparse.IsIso G G p := by
  obtain ⟨γ, hm, he⟩ := List.mem_filterMap.mp hp
  exact (runColored_trace G).generator
    (List.mem_filterMap.mpr ⟨γ, Array.mem_toList_iff.mpr (emitted_mem_trace G hm), he⟩)

theorem realized_emissions (G : GraphIso.Sparse.Colored n k) :
    Generation.Realizes G (runColored G).emittedGenerators (runColored G).emitted.toList := by
  intro γ hm
  obtain ⟨hs, p, hp, hv⟩ := runColored_trace G γ (emitted_mem_trace G hm)
  have he : Perm.ofNatArray? n γ = some p := Perm.ofNatArray?_eq hs (fun v => (hv v).symm)
  exact ⟨p, .mem (List.mem_filterMap.mpr ⟨γ, hm, he⟩),
    (GraphIso.Sparse.isIso_toDense G G p).mpr hp, fun v => (hv v).symm⟩

/-- Every automorphism is generated by the native sparse emissions. -/
theorem emissions_generate (G : GraphIso.Sparse.Colored n k) {p : Perm n}
    (hp : GraphIso.Sparse.IsIso G G p) : Perm.Generated (runColored G).emittedGenerators p := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst n
    have he : p = Perm.id 0 := Perm.ext (fun v => Fin.elim0 v)
    rw [he]
    exact .id
  · let partition := initialPartitionWith n k G.coloring.cells.toArray Fin.val
    obtain ⟨last, leaf, path, _, _⟩ := initial_path G hn
    have h := Max.FirstInput.initial G hn 100
    have htrace := Generation.root G
    have hemit := realized_emissions G
    change Generation.Realizes G (runColored G).generators
      (runState (.ofGraph G.graph) partition.1 partition.2).2.genTrace.toList at htrace
    change Generation.Realizes G (runColored G).emittedGenerators
      (runState (.ofGraph G.graph) partition.1 partition.2).2.emitted.toList at hemit
    rw [runState, ite_eq_right (by simpa using Nat.ne_of_gt hn)] at htrace hemit
    have hf : n + 1 ≤ 1 + (n + 2) := by omega
    have hbase : ∀ b : Fin n, (VSet.empty : VSet n).mem b.val = true ↔ b ∈ ([] : List (Fin n)) := by
      intro b
      simp
    have hreal := h.realizes path hf hbase htrace hemit Emission.Realization.initial
    exact h.generates path hf hbase hreal.trace p hp (Perm.Fixes.nil p)

/-- Decoding retains every emission with its exact array and order. -/
theorem emittedGenerators_raw (G : GraphIso.Sparse.Colored n k) :
    (runColored G).emittedGenerators.map (fun p => Array.ofFn fun v => (p.get v).val) =
      (runColored G).emitted.toList := by
  have hadmit : ∀ γ ∈ (runColored G).emitted.toList, ∃ p : Perm n,
      Perm.ofNatArray? n γ = some p ∧ (Array.ofFn fun v => (p.get v).val) = γ := by
    intro γ hm
    obtain ⟨hs, p, _, hv⟩ := runColored_trace G γ (emitted_mem_trace G hm)
    refine ⟨p, Perm.ofNatArray?_eq hs (fun v => (hv v).symm), ?_⟩
    apply Array.ext
    · simpa using hs.symm
    · intro i hi hj
      rw [Array.getElem_ofFn, ← getElem!_pos γ i hj]
      exact (hv ⟨i, by simpa using hi⟩).symm
  unfold State.emittedGenerators
  generalize (runColored G).emitted.toList = xs at hadmit ⊢
  induction xs with
  | nil => rfl
  | cons γ xs ih =>
    obtain ⟨p, hp, hγ⟩ := hadmit γ (by simp)
    simp only [List.filterMap_cons, hp, List.map_cons, hγ]
    rw [ih (fun δ hd => hadmit δ (List.mem_cons_of_mem _ hd))]

/-- The decoded discovery list generates every automorphism as well. -/
theorem runColored_generates (G : GraphIso.Sparse.Colored n k) {p : Perm n}
    (hp : GraphIso.Sparse.IsIso G G p) : Perm.Generated (runColored G).generators p := by
  exact (emissions_generate G hp).mono (fun q hq => by
    obtain ⟨γ, hm, he⟩ := List.mem_filterMap.mp hq
    exact List.mem_filterMap.mpr ⟨γ, Array.mem_toList_iff.mpr (emitted_mem_trace G hm), he⟩)

/-- The decoded discovery list generates exactly the native automorphism group. -/
theorem generated_iff (G : GraphIso.Sparse.Colored n k) (p : Perm n) :
    Perm.Generated (runColored G).generators p ↔ GraphIso.Sparse.IsIso G G p := by
  constructor
  · intro hp
    apply (GraphIso.Sparse.isIso_toDense G G p).mp
    exact hp.isIso (fun q hq => (GraphIso.Sparse.isIso_toDense G G q).mpr
      ((runColored_trace G).generator hq))
  · exact runColored_generates G

end Hex.GraphIso.Nauty.Sparse
